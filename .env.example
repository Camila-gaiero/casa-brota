# Copiá este archivo a .env.local y completá los valores.
# Las claves se consiguen en Supabase > Project Settings > API.

# URL del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon public". Es segura para exponerse en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Número de WhatsApp para pedidos y consultas, con prefijo de país,
# sin + ni espacios (ej: 5491140924211)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# NOTA: este proyecto NO necesita SUPABASE_SERVICE_ROLE_KEY.
# La key de servicio se usaba solo para crear el usuario admin desde el sitio,
# ahora se crea a mano en Supabase > Authentication > Users.